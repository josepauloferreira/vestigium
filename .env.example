# Copy to .env for local development. The real .env is ignored by Git.
# Use unquoted KEY=value entries shared by Compose and Spring properties.
DB_PORT=5432
DB_USERNAME=vestigium
DB_PASSWORD=vestigium-local
SERVER_PORT=8080

# Optional: override the JDBC URL for a database outside the local Compose setup.
# DB_URL=jdbc:postgresql://127.0.0.1:5432/vestigium
